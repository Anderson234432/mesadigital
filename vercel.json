{
  "rewrites": [
    {
      "source": "/r/:restauranteId/m/:mesa",
      "destination": "/restaurante/:restauranteId/menu/:mesa"
    },
    {
      "source": "/restaurante/:restauranteId/carta",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|TelegramBot|Discordbot|Googlebot|bingbot|Applebot|Pinterest|redditbot|vkShare|W3C_Validator).*"
        }
      ],
      "destination": "/api/carta-meta?restauranteId=:restauranteId"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html|/)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
