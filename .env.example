VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_MAESTRO_UID=

# App Check (reCAPTCHA Enterprise) — sin esto, initializeAppCheck nunca se
# activa (ver src/firebase.js) y crearPedido, que exige enforceAppCheck,
# rechaza todos los pedidos reales.
VITE_RECAPTCHA_SITE_KEY=

# Solo para desarrollo local: fuerza el token de depuración de App Check
# fuera de modo dev (ver src/firebase.js). Nunca debe estar activo en
# producción.
VITE_APPCHECK_DEBUG=

# Dominio base para construir la URL de los QR (PanelMaestro.jsx). Si no se
# define, usa window.location.origin.
VITE_BASE_URL=