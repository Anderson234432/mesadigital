rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    // UID hardcodeado: respaldo de gobernanza permanente. Nunca depende de
    // un documento de Firestore, así que esta cuenta no puede perderse salvo
    // perder literalmente ese login — mismo riesgo que existía antes de
    // config/maestros, sin regresión. Solo esta cuenta puede modificar quién
    // más es maestro (ver match /config/maestros más abajo).
    function esMaestroOriginal() {
      return request.auth != null
        && request.auth.uid == 'xB7aybhKvYhIkuq7TERTuMfUkaH2';
    }

    // Maestro = el UID original, o cualquier UID listado en config/maestros —
    // así el dueño puede delegar el día a día sin depender de una sola cuenta,
    // sin dejar de tener un camino de recuperación que nunca se puede perder.
    function esMaestro() {
      return esMaestroOriginal() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/config/maestros) &&
        request.auth.uid in get(/databases/$(database)/documents/config/maestros).data.get('uids', [])
      );
    }

    function getRestaurante(restauranteId) {
      return get(/databases/$(database)/documents/restaurantes/$(restauranteId)).data;
    }

    function restauranteExiste(restauranteId) {
      return exists(/databases/$(database)/documents/restaurantes/$(restauranteId));
    }

    // Admin: maestro O usuario en adminUids del restaurante
    function esAdmin(restauranteId) {
      return esMaestro() || (
        request.auth != null &&
        restauranteExiste(restauranteId) &&
        request.auth.uid in getRestaurante(restauranteId).get('adminUids', [])
      );
    }

    // Personal del restaurante: admin O usuario en cocinaUids
    function esPersonal(restauranteId) {
      return esMaestro() || (
        request.auth != null &&
        restauranteExiste(restauranteId) && (
          request.auth.uid in getRestaurante(restauranteId).get('adminUids', []) ||
          request.auth.uid in getRestaurante(restauranteId).get('cocinaUids', [])
        )
      );
    }

    // Si el restaurante tiene mesaTokens configurado (en la subcolección privada
    // _privado/mesaTokens, no en el documento público), el token enviado debe
    // coincidir con el de esa mesa. Restaurantes sin mesaTokens no lo exigen
    // (compatibilidad hacia atrás).
    function tokenDeMesaValido(restauranteId, mesa, tokenEnviado) {
      let ruta = /databases/$(database)/documents/restaurantes/$(restauranteId)/_privado/mesaTokens;
      let tokens = exists(ruta) ? get(ruta).data.get('mesaTokens', null) : null;
      return tokens == null || tokens[mesa] == tokenEnviado;
    }

    // ── Restaurantes ───────────────────────────────────────────────────────────

    match /restaurantes/{restauranteId} {
      // Lectura pública POR ID: clientes necesitan nombre, tiempos y stats de
      // SU restaurante. `get` y `list` son operaciones separadas en Firestore
      // Rules (mismo patrón que invitaciones/{token} más abajo) — `get`
      // pública permite leer un restaurante conocido por ID (Menu.jsx,
      // Admin.jsx, Cocina.jsx, Invitacion.jsx solo hacen esto), pero `list`
      // (enumerar la colección completa) se restringe al maestro. Sin este
      // split, cualquiera sin sesión puede listar TODOS los restaurantes —
      // nombre, adminUids y cocinaUids incluidos — con una sola query sin
      // autenticar, algo que ningún flujo de la app necesita (solo
      // PanelMaestro.jsx enumera la colección completa, y ya requiere ser
      // maestro).
      allow get: if true;
      allow list: if esMaestro();

      // Solo el maestro puede crear o eliminar restaurantes
      allow create, delete: if esMaestro();

      // Maestro y admins pueden actualizar cualquier campo del documento público
      // (tiempos, roles, numMesas...). mesaTokens vive aparte, en _privado/.
      // Cocina solo puede tocar stats (necesita actualizar stats.mesasPendientes al archivar).
      allow update: if
        esAdmin(restauranteId) ||
        (
          esPersonal(restauranteId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats'])
        );

      // ── Platos ──────────────────────────────────────────────────────────────

      match /platos/{platoId} {
        // Lectura pública: clientes navegan el menú
        allow read: if true;
        // Solo admins gestionan el menú
        allow write: if esAdmin(restauranteId);
      }

      // ── Categorías (metadatos de presentación) ─────────────────────────────
      // Qué categorías/subcategorías EXISTEN se sigue derivando de `platos`
      // (ver src/utils/menuCategorias.js) — esto solo guarda imagen/orden,
      // opcional, mismo patrón de acceso que platos. El id del documento es
      // un slug determinista (ver src/utils/slug.js), nunca lo elige el
      // cliente libremente ni afecta qué se muestra si no existe.
      match /categorias/{categoriaId} {
        allow read: if true;
        allow write: if esAdmin(restauranteId);
      }

      // ── Pedidos ─────────────────────────────────────────────────────────────

      match /pedidos/{pedidoId} {
        // Personal autenticado lee todos los pedidos.
        // Clientes anónimos solo leen sus propios pedidos (aislamiento por mesa).
        allow read: if
          request.auth != null && (
            esPersonal(restauranteId) ||
            resource.data.get('clienteUid', '') == request.auth.uid
          );

        // Clientes (auth anónima requerida) pueden crear pedidos.
        // La Cloud Function es el path normal (usa Admin SDK, omite estas reglas).
        // Este es el fallback cuando Cloud Functions no está disponible: aquí es
        // donde se rechazan pedidos con total/items fuera de rango, ya que este
        // path no coteja precios contra platos/ (ver nota en pedidosRepository.js).
        allow create: if
          request.auth != null &&
          request.resource.data.keys().hasAll(['mesa', 'items', 'total', 'estado', 'creadoEn']) &&
          request.resource.data.estado == 'pendiente' &&
          // El pedido solo puede atribuirse al propio uid autenticado — si no,
          // un cliente podría escribir clienteUid de otra persona y contaminar
          // su historial de pedidos (ver allow read arriba).
          request.resource.data.get('clienteUid', '') == request.auth.uid &&
          request.resource.data.mesa is string &&
          request.resource.data.mesa.size() > 0 &&
          request.resource.data.mesa.size() <= 20 &&
          restauranteExiste(restauranteId) &&
          tokenDeMesaValido(restauranteId, request.resource.data.mesa, request.resource.data.get('mesaToken', '')) &&
          // 65000 en vez de 50000: el total ahora puede incluir ITBIS (18%) +
          // propina legal (10%), hasta +28% sobre el subtotal — se sube el
          // tope para no rechazar pedidos legítimos grandes con ambos
          // impuestos activos (50000 * 1.28 ≈ 64000).
          request.resource.data.total is number &&
          request.resource.data.total >= 0 &&
          request.resource.data.total <= 65000 &&
          request.resource.data.items is list &&
          request.resource.data.items.size() <= 30 &&
          (
            // "Llamar al mesero" es un pedido sin platos: items vacío y total 0.
            request.resource.data.get('tipo', '') == 'llamada'
              ? (request.resource.data.items.size() == 0 && request.resource.data.total == 0)
              : (request.resource.data.items.size() > 0 && request.resource.data.total >= 1)
          ) &&
          request.resource.data.get('nota', '') is string &&
          request.resource.data.get('nota', '').size() <= 500;

        // Solo personal (cocina y admin) puede cambiar estado o archivar pedidos
        allow update, delete: if
          request.auth != null &&
          esPersonal(restauranteId);
      }

      // ── Rate limits (solo Cloud Function via Admin SDK) ──────────────────────
      // No hay regla aquí → clientes no pueden leer ni escribir _ratelimits
      match /_ratelimits/{uid} {
        allow read, write: if false;
      }

      // ── Ventas diarias agregadas (solo Cloud Function via Admin SDK) ─────────
      // Un documento por día con totales y ranking de platos ya sumados —
      // Admin.jsx lee esto para semana/mes en vez de leer todos los pedidos
      // del período (lo que causaba el límite de 500 y totales incompletos).
      // Solo personal del restaurante puede leerlo (dato de ventas sensible).
      match /ventasDiarias/{fecha} {
        allow read: if esPersonal(restauranteId);
        allow write: if false;
      }

      // ── Datos privados (mesaTokens) ───────────────────────────────────────────
      // Firestore no soporta seguridad a nivel de campo: mesaTokens no puede vivir
      // en el documento público de restaurantes/{id} (que tiene allow read: if true)
      // sin quedar expuesto a cualquiera que conozca el restauranteId. Vive aquí,
      // solo accesible por el maestro (gestiona los QR) y por la Cloud Function
      // (que usa Admin SDK y omite Rules).
      match /_privado/{docId} {
        allow read, write: if esMaestro();
      }
    }

    // ── Invitaciones de registro (admin/cocina) ─────────────────────────────────
    // Colección top-level, no subcolección: el token ES el ID del documento, así
    // la pantalla de registro hace un getDoc directo por ID sin necesitar query.
    // `get` (leer por token, sin sesión) y `list` (enumerar) son operaciones
    // separadas en Firestore Rules — se permite la primera para que /invitacion/
    // :token pueda validar antes de pedir datos, y se niega la segunda a
    // cualquiera que no sea el maestro, para que nadie pueda enumerar invitaciones
    // válidas. Otorgar el rol y marcar la invitación como usada NO pasa por estas
    // reglas — lo hace la Cloud Function canjearInvitacion con Admin SDK.
    match /invitaciones/{token} {
      allow get: if true;
      allow list: if esMaestro();
      allow create, update, delete: if esMaestro();

      // ── Código de verificación + contadores (solo Cloud Function via Admin
      // SDK) ──────────────────────────────────────────────────────────────────
      // El hash del código de 6 dígitos, sus intentos y el rate limit de
      // reenvíos viven aquí. No hay regla que otorgue acceso → nadie desde el
      // cliente puede leerlos ni escribirlos, bajo ninguna circunstancia.
      match /_privado/{docId} {
        allow read, write: if false;
      }
    }

    // ── Lista de co-maestros ────────────────────────────────────────────────────
    // { uids: [...] } — solo el UID original puede escribirla. Si cualquier
    // maestro pudiera hacerlo, un co-maestro comprometido (o un error) podría
    // vaciar la lista y dejar fuera hasta al dueño. Restringir la escritura al
    // UID original preserva la garantía de que esa cuenta nunca se pierde,
    // mientras permite delegar el trabajo diario a co-maestros.
    match /config/maestros {
      allow read: if esMaestro();
      allow write: if esMaestroOriginal();
    }
  }
}
